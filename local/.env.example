# Copy this file to .env. The real .env is ignored by Git.

# AWS S3 access used by the Web API and both workers.
AWS_REGION=ap-south-2
AWS_ACCESS_KEY_ID=replace-with-local-poc-access-key
AWS_SECRET_ACCESS_KEY=replace-with-local-poc-secret-key
AWS_SESSION_TOKEN=
S3_BUCKET=questacase
S3_PREFIX=judgments

# Existing AWS Neo4j instance. Permit your current public IP on TCP 7474.
NEO4J_URL=http://ec2-16-112-8-114.ap-south-2.compute.amazonaws.com:7474
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_REQUIRED=true

# Existing AWS Qdrant instance. Permit your current public IP on TCP 6333.
QDRANT_URL=http://ec2-16-113-78-201.ap-south-2.compute.amazonaws.com:6333
QDRANT_WRITE_API_KEY=replace-with-qdrant-write-key
QDRANT_READ_API_KEY=replace-with-qdrant-read-only-key
QDRANT_COLLECTION=judgment_chunks

# Shared secret between the local Web API and local embedding API.
EMBEDDING_API_KEY=replace-with-local-embedding-api-key

# Local inference and processing controls.
OLLAMA_VERSION=0.40.15
OLLAMA_MODEL=qwen3:4b
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=24h
INFERENCE_MEMORY_LIMIT=8g
INFERENCE_CPU_LIMIT=4.0
INFERENCE_MAX_CONNECTIONS=1
INFERENCE_NUM_PREDICT=600
KG_NUM_PREDICT=3000
KG_REQUEST_TIMEOUT=1800
EMBEDDING_THREADS=2
WORKER_MAX_ATTEMPTS=3
KEEP_JOB_FILES=false
REQUEST_TIMEOUT_MS=300000
